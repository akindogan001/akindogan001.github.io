---
/**
 * Kök adres: kayıtlı dil tercihi → tarayıcı dili → İngilizce sırasıyla yönlendirir.
 * GitHub Pages sunucu tarafı yönlendirme yapamadığı için küçük bir istemci betiği kullanılır.
 */
import site from '../data/site.json';
import { url, asset, BASE } from '../lib/i18n';
const abs = (lang: 'tr' | 'en') => new URL(url(lang), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" hreflang="tr" href={abs('tr')} />
    <link rel="alternate" hreflang="en" href={abs('en')} />
    <link rel="alternate" hreflang="x-default" href={abs('en')} />
    <script is:inline define:vars={{ base: BASE }}>
      (function () {
        var lang = null;
        try {
          lang = localStorage.getItem('lang');
        } catch (e) {}
        if (lang !== 'tr' && lang !== 'en') {
          var langs = navigator.languages || [navigator.language || ''];
          lang = langs.some(function (l) { return /^tr\b/i.test(l); }) ? 'tr' : 'en';
        }
        location.replace(base + '/' + lang + '/');
      })();
    </script>
    <style>
      body { font: 16px/1.6 system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; background: #14181d; color: #d7dde3; }
      a { color: #6ea8fe; margin: 0 8px; }
    </style>
  </head>
  <body>
    <p><a href={url('tr')}>Türkçe</a> · <a href={url('en')}>English</a></p>
  </body>
</html>
