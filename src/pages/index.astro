---
/**
 * Kök adres: kayıtlı dil tercihi → tarayıcı dili → İngilizce sırasıyla yönlendirir.
 * GitHub Pages sunucu tarafı yönlendirme yapamadığı için küçük bir istemci betiği kullanılır.
 */
import site from '../data/site.json';
const base = Astro.site!.href.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="tr" href={`${base}/tr/`} />
    <link rel="alternate" hreflang="en" href={`${base}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${base}/en/`} />
    <script is:inline>
      (function () {
        var lang = null;
        try {
          lang = localStorage.getItem('lang');
        } catch (e) {}
        if (lang !== 'tr' && lang !== 'en') {
          var langs = navigator.languages || [navigator.language || ''];
          lang = langs.some(function (l) { return /^tr\b/i.test(l); }) ? 'tr' : 'en';
        }
        location.replace('/' + lang + '/');
      })();
    </script>
    <style>
      body { font: 16px/1.6 system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; background: #f6f5f0; color: #1b2430; }
      a { color: #1f4e99; margin: 0 8px; }
      @media (prefers-color-scheme: dark) { body { background: #14181d; color: #d7dde3; } a { color: #6ea8fe; } }
    </style>
  </head>
  <body>
    <p><a href="/tr/">Türkçe</a> · <a href="/en/">English</a></p>
  </body>
</html>
