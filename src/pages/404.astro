---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
const tr = t('tr');
const en = t('en');
---

<Base lang="en" title="404" hasAlternate={false}>
  <section class="container section">
    <span class="eyebrow">ERR 404</span>
    <h1>{en.notFound.title} · {tr.notFound.title}</h1>
    <p class="lead">{en.notFound.text}<br />{tr.notFound.text}</p>
    <div class="btn-row">
      <a class="btn" href="/en/">{en.notFound.back}</a>
      <a class="btn btn--ghost" href="/tr/">{tr.notFound.back}</a>
    </div>
  </section>
</Base>
